{
  "name": "appcapsule",
  "version": "0.1.0",
  "description": "Turn your Vite app into a verified, offline HTML demo. Real interactions. One portable file.",
  "type": "module",
  "bin": {
    "appcapsule": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e.mjs",
    "check": "npm run test && npm run test:e2e",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "offline",
    "demo",
    "vite",
    "react",
    "single-file",
    "playwright",
    "local-first"
  ],
  "license": "MIT",
  "author": "Carlo (carlogiovannifalocco-byte)",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlogiovannifalocco-byte/appcapsule.git"
  },
  "bugs": "https://github.com/carlogiovannifalocco-byte/appcapsule/issues",
  "homepage": "https://github.com/carlogiovannifalocco-byte/appcapsule#readme",
  "dependencies": {
    "@playwright/test": "^1.56.1",
    "parse5": "^8.0.0",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
